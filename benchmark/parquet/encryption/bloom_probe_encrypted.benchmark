# name: benchmark/parquet/encryption/bloom_probe_encrypted.benchmark
# description: parquet_bloom_probe over all row groups of an encrypted file
# group: [encryption]

name parquet_bloom_probe (encrypted)
group parquet
subgroup encryption

require parquet

load
SET force_mbedtls_unsafe = 'true';
PRAGMA add_parquet_key('key256', '01234567891123450123456789112345');
COPY (SELECT (hash(i) % 20000)::BIGINT * 2 AS k, i FROM range(10000000) t(i)) TO '${BENCHMARK_DIR}/bloom_probe_encrypted.parquet' (ROW_GROUP_SIZE 100000, DICTIONARY_SIZE_LIMIT 100000, ENCRYPTION_CONFIG {footer_key: 'key256'});

run
SELECT count(*) FILTER (bloom_filter_excludes) FROM parquet_bloom_probe('${BENCHMARK_DIR}/bloom_probe_encrypted.parquet', 'k', 12345, encryption_config={footer_key: 'key256'});

result I
100
