# name: benchmark/parquet/encryption/bloom_filter_point_lookup_encrypted_no_bloom.benchmark
# description: Point lookup on a missing value where only bloom filters can prune row groups (encrypted, no bloom filters)
# group: [encryption]

name Bloom filter point lookup (encrypted, no bloom filters)
group parquet
subgroup encryption

require parquet

load
SET force_mbedtls_unsafe = 'true';
PRAGMA add_parquet_key('key256', '01234567891123450123456789112345');
COPY (SELECT (hash(i) % 20000)::BIGINT * 2 AS k, i FROM range(10000000) t(i)) TO '${BENCHMARK_DIR}/bloom_lookup_encrypted_no_bloom.parquet' (ROW_GROUP_SIZE 100000, DICTIONARY_SIZE_LIMIT 100000, ENCRYPTION_CONFIG {footer_key: 'key256'}, WRITE_BLOOM_FILTER false);

run
SELECT count(*) FROM read_parquet('${BENCHMARK_DIR}/bloom_lookup_encrypted_no_bloom.parquet', encryption_config={footer_key: 'key256'}) WHERE k = 12345;

result I
0
